# ── PostgreSQL connection ──────────────────────────────────────────
PGHOST=127.0.0.1
PGPORT=3309
PGUSER=postgres
PGPASSWORD=your-password-here
PGDATABASE=tapsite
# Set to "true" if PG requires SSL
# PGSSL=true

# Max rows returned per query (default 500)
MCP_DB_MAX_ROWS=500

# ── Server deployment (SSE mode) ──────────────────────────────────
# Set MCP_PORT > 0 to run as HTTP/SSE server instead of stdio.
# MCP_PORT=3100

# Shared secret for SSE endpoint auth.
# Clients must send Authorization: Bearer <token> or ?api_key=<token>.
# Leave empty to disable auth (NOT recommended for production).
# MCP_AUTH_TOKEN=your-secret-token-here
